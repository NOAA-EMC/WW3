! sample-jonswap: 100 km x 100 km Cartesian domain, 1 km spacing, uniform 1000 m depth (runs/sample-jonswap/SPEC.md)
&SPECTRUM_NML
  SPECTRUM%XFR       =  1.1
  SPECTRUM%FREQ1     =  0.05
  SPECTRUM%NK        =  32
  SPECTRUM%NTH       =  36
  SPECTRUM%THOFF     =  0.
/
&RUN_NML
  RUN%FLCX         =  T
  RUN%FLCY         =  T
  RUN%FLCTH        =  T
  RUN%FLSOU        =  T
/
&TIMESTEPS_NML
  TIMESTEPS%DTMAX        =  150.
  TIMESTEPS%DTXY         =  50.
  TIMESTEPS%DTKTH        =  75.
  TIMESTEPS%DTMIN        =  10.
/
&GRID_NML
  GRID%NAME         =  'SAMPLE JONSWAP 100KM'
  GRID%NML          =  '../input/namelists.nml'
  GRID%TYPE         =  'RECT'
  GRID%COORD        =  'CART'
  GRID%CLOS         =  'NONE'
  GRID%ZLIM         =  -0.1
  GRID%DMIN         =  2.5
/
&RECT_NML
  RECT%NX           =  101
  RECT%NY           =  101
  RECT%SX           =  1000.
  RECT%SY           =  1000.
  RECT%X0           =  0.
  RECT%Y0           =  0.
/
&DEPTH_NML
  DEPTH%SF        =  -1.
  DEPTH%FILENAME  =  '../input/depth.dat'
  DEPTH%IDLA      =  2
  DEPTH%IDFM      =  1
/
! West edge x = 0 (ix = 1, iy = 1..101): boundary points. Without nest.ww3 the
! initial spectrum (ww3_strt.inp) is kept there, so the JONSWAP keeps entering.
&INBND_COUNT_NML
  INBND_COUNT%N_POINT    =  2
/
&INBND_POINT_NML
  INBND_POINT(1)         =  1 1 F
  INBND_POINT(2)         =  1 101 T
/
