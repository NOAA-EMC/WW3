! sample-jonswap: 24 h with a homogeneous 5 m/s wind from the west
&DOMAIN_NML
  DOMAIN%START   = '20200101 000000'
  DOMAIN%STOP    = '20200102 000000'
/
&INPUT_NML
  INPUT%FORCING%WINDS = 'H'
/
&OUTPUT_TYPE_NML
  TYPE%FIELD%LIST          = 'HS T02 T0M1 FP DIR SPR DP WND'
  TYPE%POINT%FILE          = '../input/points.list'
/
&OUTPUT_DATE_NML
  DATE%FIELD          = '20200101 000000' '3600' '20200102 000000'
  DATE%POINT          = '20200101 000000' '3600' '20200102 000000'
/
! Homogeneous wind: VALUE1 speed (m/s), VALUE2 direction it comes FROM
! (nautical, deg), VALUE3 air-sea temperature difference. Same value at the
! start and the end, so it is constant over the run.
&HOMOG_COUNT_NML
  HOMOG_COUNT%N_WND = 2
/
&HOMOG_INPUT_NML
  HOMOG_INPUT(1)%NAME   = 'WND'
  HOMOG_INPUT(1)%DATE   = '20200101 000000'
  HOMOG_INPUT(1)%VALUE1 = 5.
  HOMOG_INPUT(1)%VALUE2 = 270.
  HOMOG_INPUT(1)%VALUE3 = 0.
  HOMOG_INPUT(2)%NAME   = 'WND'
  HOMOG_INPUT(2)%DATE   = '20200102 000000'
  HOMOG_INPUT(2)%VALUE1 = 5.
  HOMOG_INPUT(2)%VALUE2 = 270.
  HOMOG_INPUT(2)%VALUE3 = 0.
/
