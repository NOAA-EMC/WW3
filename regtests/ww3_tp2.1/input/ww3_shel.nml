! -------------------------------------------------------------------- !
! WAVEWATCH III ww3_shel.nml - single-grid model                       !
! -------------------------------------------------------------------- !


! -------------------------------------------------------------------- !
! Define top-level model parameters via DOMAIN_NML namelist
! -------------------------------------------------------------------- !
&DOMAIN_NML
  DOMAIN%STOP    = '19680606 050000'
/

! -------------------------------------------------------------------- !
! Define each forcing via the INPUT_NML namelist
! -------------------------------------------------------------------- !
&INPUT_NML
/

! -------------------------------------------------------------------- !
! Define the output types point parameters via OUTPUT_TYPE_NML namelist
! -------------------------------------------------------------------- !
&OUTPUT_TYPE_NML
  TYPE%FIELD%LIST          = 'HS FP DIR DP'
/

! -------------------------------------------------------------------- !
! Define output dates via OUTPUT_DATE_NML namelist
! -------------------------------------------------------------------- !
&OUTPUT_DATE_NML
  DATE%FIELD          = '19680606 000000' '360' '19680608 000000'
/

! -------------------------------------------------------------------- !
! Define output user path via OUTPUT_PATH_NML namelist
! -------------------------------------------------------------------- !
&OUTPUT_PATH_NML
!  PATH%GRD_OUT = '/work2/noaa/marine/ming.chen/ww3_tp2.1/grd_out/'
  PATH%GRD_OUT = '/work2/noaa/marine/ming.chen/user_def_path/regtests/ww3_tp2.1/grd_out/'
  PATH%PNT_OUT = '/work2/noaa/marine/ming.chen/user_def_path/regtests/ww3_tp2.1/pnt_out/'
/

! -------------------------------------------------------------------- !
! Define homogeneous input via HOMOG_COUNT_NML and HOMOG_INPUT_NML namelist
! -------------------------------------------------------------------- !
&HOMOG_COUNT_NML
/

&HOMOG_INPUT_NML
/

! -------------------------------------------------------------------- !
! WAVEWATCH III - end of namelist                                      !
! -------------------------------------------------------------------- !
